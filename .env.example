# Copy to .env and adjust. Every value is optional.
# The app always binds to 127.0.0.1; only the port is configurable.
RESUAPPLY_PORT=8000

# Folder for the SQLite database (relative paths resolve from the project root).
RESUAPPLY_DATA_DIR=data

# Hosted model through OpenRouter (https://openrouter.ai). Without a key, everything
# except the AI buttons still works: you can enter requirements and evidence by hand.
OPENROUTER_API_KEY=
# Any OpenRouter model ID that supports tool calling. Changing it is always your decision.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# free:    the provider may log or train on prompts; you review and approve what is sent.
# trusted: a provider/model whose data terms you accept; the review step is optional.
OPENROUTER_MODEL_TRUST=free
